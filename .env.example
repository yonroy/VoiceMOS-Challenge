# Mẫu biến môi trường — COPY thành .env rồi điền giá trị thật.
# .env chứa secret thật và KHÔNG được commit.

# CodaBench competition URL (secret_key BTC gửi qua email đăng ký)
CODABENCH_COMPETITION_URL=https://www.codabench.org/competitions/16419/?secret_key=<YOUR_SECRET_KEY>
CODABENCH_SECRET_KEY=<YOUR_SECRET_KEY>

# Gemini API key cho baseline EMOS/VAD (Track 2)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
